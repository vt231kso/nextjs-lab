// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
//Таблиця для статтей
model Article {
  id          Int        @id @default(autoincrement())
  title       String     @db.Text
  body        String     @db.Text
  isFavorite  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

//. Додаємо зв'язок з автором
authorId    Int
author      Profile    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]
}

// Таблиця для коментарів (підв'язана до Article)
model Comment {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  body      String   @db.Text
  createdAt DateTime @default(now())

  // Зовнішній ключ для зв'язку зі статтею
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// Таблиця для профілю користувача
model Profile {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  bio       String?  @db.Text
  image     String?  // URL аватара
  // Налаштування (відповідає твоїм сторінкам /settings та /security)
  settings  Json?    @default("{\"theme\": \"light\", \"notifications\": true}")
  security  Json?    @default("{\"twoFactorEnabled\": false}")
  createdAt DateTime @default(now())
  articles  Article[]
}
